{
  "name": "medgemma-radiology-pacs",
  "version": "1.0.0",
  "description": "AI-Assisted Emergency Radiology Triage using Med Gemma",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "python-setup": "cd src/python && python -m venv venv && venv\\Scripts\\activate && pip install -r requirements.txt"
  },
  "keywords": [
    "radiology",
    "PACS",
    "AI",
    "medical-imaging",
    "electron"
  ],
  "author": "MedGamma Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^40.1.0",
    "electron-builder": "^26.6.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "build": {
    "appId": "com.medgemma.radiologypacs",
    "productName": "MedGemma Radiology PACS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/renderer/**/*",
      "src/python/**/*"
    ],
    "extraResources": [
      {
        "from": "src/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
